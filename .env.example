# Supabase — client-side (safe to expose; RLS protects the data).
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER commit the service-role key. It is used only for server-side/admin scripts
# (e.g. Edge Functions) and must stay out of the client bundle and out of git.
# SUPABASE_SERVICE_ROLE_KEY=...
